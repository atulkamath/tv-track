# Clerk (ADR 0003). Same Clerk project as the backend's CLERK_SECRET_KEY
# (backend/.env.example) — the publishable key is safe to expose to the
# browser; the secret key here is only used by src/middleware.ts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Where the NestJS backend (ADR 0004) is reachable from the browser.
NEXT_PUBLIC_API_URL="http://localhost:3001"
