# Postgres the app runs against in development.
# Tests never use this — they boot their own embedded Postgres (see test/global-setup.ts).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tvtrack?schema=public"

# Clerk (ADR 0003). The secret key is what verifies incoming session tokens.
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."

# Origin allowed to call this API (the Next.js frontend, ADR 0004/0005).
FRONTEND_ORIGIN="http://localhost:3000"

# TMDB (ADR 0002). Backs GET /shows/search and the TMDB mirror.
# The v4 "API Read Access Token" (a long JWT), sent as a bearer token — not
# the older v3 API key.
TMDB_ACCESS_TOKEN="..."

PORT=3001

# OpenRouter — the LLM provider behind NLP Entry. Optional: without it the API
# still boots, and only the LLM routes fail.
# Free keys are capped at 20 requests/minute and 50/day.
#
# Pin one model rather than using `openrouter/free`. Per OpenRouter's own page,
# that router "selects free models at random" — it does filter for the features
# a request needs (structured outputs included), so calls would still work, but
# a different model could answer each time. The parse prompt is tuned to one
# model's specific mistakes, so a moving model means parse quality that varies
# per request and prompt changes that can't be evaluated against a fixed
# baseline. Swap this value to change models; don't let the router decide.
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"
