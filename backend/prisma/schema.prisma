generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A person with an account in the app. Created lazily on their first
/// authenticated request — there is no Clerk webhook (see docs/mvp-scope.md).
model User {
  id          String   @id @default(uuid()) @db.Uuid
  /// Clerk's subject id (`sub` claim). The identity we key everything off.
  clerkUserId String   @unique @map("clerk_user_id")
  /// Backfilled from Clerk (see `ClerkUserDirectory`) the same moment the row
  /// is lazily created. Used, alongside Friend Code, to look someone up when
  /// sending a Friend Request (CONTEXT.md).
  email       String   @unique
  /// 6-char lookup code, regenerable. See CONTEXT.md → Friend Code.
  friendCode  String   @unique @map("friend_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sentFriendRequests     FriendRequest[]  @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[]  @relation("ReceivedFriendRequests")
  friendshipsAsUser      Friendship[]     @relation("FriendshipsAsUser")
  friendshipsAsFriend    Friendship[]     @relation("FriendshipsAsFriend")
  watchedEpisodes        WatchedEpisode[]

  @@map("users")
}

/// An invitation from one User to another to become Friends (CONTEXT.md).
/// Exists only while pending — accept turns it into a Friendship and decline
/// deletes it, so this table always holds pending requests only, never a
/// history.
model FriendRequest {
  id          String   @id @default(uuid()) @db.Uuid
  sender      User     @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  senderId    String   @map("sender_id") @db.Uuid
  recipient   User     @relation("ReceivedFriendRequests", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String   @map("recipient_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  // Prevents a second identical pending request from the same sender to the
  // same recipient; FriendRequestsService also treats hitting this as a
  // benign convergence rather than an error (see UsersService's Friend Code
  // race handling for the same pattern).
  @@unique([senderId, recipientId])
  @@map("friend_requests")
}

/// A mutual, accepted connection between two Users (CONTEXT.md). Stored as one
/// row per direction so "my Friends" is a plain `WHERE user_id = me` query —
/// no unfriending exists yet (see docs/mvp-scope.md), so keeping both
/// directions in sync is only ever an insert, never a delete.
model Friendship {
  id        String   @id @default(uuid()) @db.Uuid
  user      User     @relation("FriendshipsAsUser", fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  friend    User     @relation("FriendshipsAsFriend", fields: [friendId], references: [id], onDelete: Cascade)
  friendId  String   @map("friend_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, friendId])
  @@map("friendships")
}

/// The shared TMDB catalog mirror (ADR 0002) — owned by no User. Populated the
/// first time a show is added (a later ticket); this ticket only needs the
/// shape to exist. `GET /shows/search` reads TMDB directly and never touches
/// this table.
model Show {
  id           String   @id @default(uuid()) @db.Uuid
  /// TMDB's own id for this show — the join key used by Show Refresh.
  tmdbId       Int      @unique @map("tmdb_id")
  title        String
  /// Year of first air date, or null if TMDB doesn't have one.
  firstAirYear Int?     @map("first_air_year")
  posterPath   String?  @map("poster_path")
  /// TMDB's status string (e.g. "Ended", "Returning Series"); Show Refresh
  /// skips shows TMDB marks Ended (see docs/mvp-scope.md).
  status       String?
  seasons      Season[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("shows")
}

/// One season of a mirrored Show. See `Show` for why this table is shared.
model Season {
  id           String    @id @default(uuid()) @db.Uuid
  show         Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  showId       String    @map("show_id") @db.Uuid
  /// TMDB's own id for this season.
  tmdbId       Int       @unique @map("tmdb_id")
  seasonNumber Int       @map("season_number")
  episodes     Episode[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([showId, seasonNumber])
  @@map("seasons")
}

/// One episode of a mirrored Season. Runtime is what Watch Time sums over
/// (see CONTEXT.md → Watch Time).
model Episode {
  id             String   @id @default(uuid()) @db.Uuid
  season         Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId       String   @map("season_id") @db.Uuid
  /// TMDB's own id for this episode.
  tmdbId         Int      @unique @map("tmdb_id")
  episodeNumber  Int      @map("episode_number")
  /// Minutes, per TMDB. Null when TMDB hasn't published a runtime yet.
  runtimeMinutes Int?     @map("runtime_minutes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  watchedBy WatchedEpisode[]

  @@unique([seasonId, episodeNumber])
  @@map("episodes")
}

/// Exists iff a given User has watched a given Episode (ADR 0002) — never a
/// "watched: false" row. Watch State and Watch Time are always derived from
/// which rows exist here, never stored as a separate flag.
model WatchedEpisode {
  id        String   @id @default(uuid()) @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  episodeId String   @map("episode_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, episodeId])
  @@map("watched_episodes")
}
